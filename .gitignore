# Local docker-compose overrides (host paths, etc.); .env.example is the template
/.env

# Claude Code machine-local settings
.claude/settings.local.json

# Node dependencies (frontend/ has its own; this also catches a stray root install)
node_modules/

# Scratch/screenshot dir (local only)
temp/

# Playwright run artifacts
test-results/

# Agent workflow artifacts (review diffs, progress notes)
.superpowers/

# Spec Kit extension catalog cache (machine-local, refetched on demand)
.specify/extensions/.cache/

# Production env files are generated on the server and must never be committed --
# the repository is public. Only the .example templates belong here.
/deploy/**/.env
/deploy/backend.env
/deploy/data/
