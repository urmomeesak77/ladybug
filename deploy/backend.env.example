# Production Laravel environment TEMPLATE. setup.sh copies this to
# /web/online-trash.com/backend.env and fills in the generated secrets.
#
# NEVER commit a filled-in copy. The repository is public.

APP_NAME=Online-Trash
APP_ENV=production
# Generated by setup.sh: base64:<32 random bytes>
APP_KEY=
APP_DEBUG=false
APP_URL=https://online-trash.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
COMMENT_THROTTLE=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Non-root user, scoped by MySQL first-init to the trashdb database only.
DB_CONNECTION=mysql
DB_HOST=ladybug-mysql
DB_PORT=3306
DB_DATABASE=trashdb
DB_USERNAME=ladybug
DB_PASSWORD=

# Seconds PDO waits to CONNECT to MySQL before giving up (PDO::ATTR_TIMEOUT). This is what
# bounds a request's delay when the store is down or unreachable: the access-log write
# below fails inside this budget, is reported into laravel.log, and the visitor still gets
# a normal response. It bounds the CONNECT only -- a store that accepts the connection and
# then stalls mid-statement is not covered, because PDO's MySQL driver exposes no read
# timeout. Applies to every query the app makes, not just the access log. Default 2.
DB_CONNECT_TIMEOUT=2

# HTTP access log (023). One row in `access_logs` per request the APPLICATION handled,
# written synchronously before the response is delivered. Read at startup, so any change
# here takes effect on the next `deploy.sh` (or a restart of ladybug-php).
#
# SCOPE, and the first thing to know before reading the history: the access log records
# requests handled by the APPLICATION only. Requests answered directly by nginx -- the
# SPA's static assets and everything under /storage/ -- never reach PHP and therefore
# never appear here. The history answers "who called the API for this meme"; it does not
# answer "who fetched this image file". Ingesting nginx's own access log is a separate
# mechanism with different fields and is not part of this feature.
#
# ENABLED: absent from this file entirely means ON, so a fresh deployment records without
# anyone remembering to enable it. Off writes nothing and erases nothing -- rows already
# stored stay, and responses are byte-for-byte what they would be with the feature
# absent. Default true.
ACCESS_LOG_ENABLED=true
# EXCLUDED_PATHS: comma-separated, matched with $request->is(), so Laravel's `*` wildcards
# work (admin/*) and patterns carry NO leading slash. The two defaults are the liveness
# probes this deployment polls continuously -- api/health is what deploy.sh, restore.sh
# and the edge health check poll -- which would otherwise outnumber real traffic in the
# history. Authentication endpoints are deliberately NOT excluded: they are recorded
# *and* redacted. Default api/health,up.
ACCESS_LOG_EXCLUDED_PATHS=api/health,up
# RETENTION_DAYS: `php artisan access-log:prune` deletes rows strictly older than this
# many days, on the schedule below, driven by the ladybug-scheduler service. Values under
# 1 are clamped to 1 -- a 0 would delete the whole history the window was meant to bound.
# Default 30.
ACCESS_LOG_RETENTION_DAYS=30
# VALUE_LIMIT: bytes, applied PER VALUE -- each query parameter, each form field, each
# cookie and the raw body are capped independently, and an entry itself has no ceiling.
# Worst-case entry size is therefore value count x limit, NOT the limit: size the server's
# disk against observed traffic, not against this number. Raising it needs no migration
# (`body` is longtext and the parameter columns are JSON). Default 65536.
ACCESS_LOG_VALUE_LIMIT=65536
# PRUNE_ENABLED / PRUNE_CRON: the application drives its own daily prune so the box needs
# no host-level cron entry. 03:00 keeps the delete off the docs/DEPLOYMENT.md backup
# window on a 1 vCPU box. Defaults true and "0 3 * * *".
ACCESS_LOG_PRUNE_ENABLED=true
ACCESS_LOG_PRUNE_CRON="0 3 * * *"

# MUST stay `database` (022). "A password change ends every other session" is
# SessionRevoker's `DELETE FROM sessions WHERE user_id = ?`; under the `file` driver that
# table is permanently empty, so the delete silently does nothing while the API still
# answers 200. Rotating remember_token invalidates nothing either, because 018's remember-me is a
# presence cookie plus session lifetime, not Laravel's recaller. Switching this back to
# `file` disables the feature's headline security control (FR-016, US5) in production only,
# where no test can see it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=online-trash.com
# The site is HTTPS-only, so the session cookie must never travel in clear.
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=online-trash.com,www.online-trash.com
FRONTEND_URL=https://online-trash.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing in app/ implements ShouldQueue, so mail is sent synchronously and there is
# no queue worker to run. Anything queued under a `database` driver would never run.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Reused from the dev configuration: a real mailbox on the domain.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zone.eu
MAIL_PORT=587
MAIL_USERNAME="no-reply@online-trash.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@online-trash.com"
MAIL_FROM_NAME="${APP_NAME}"

# "Sign in with Google" OAuth client (017). Filled in on the server only -- the id and
# secret are secrets and this template is public. The redirect URI below must be
# registered on the Google client byte for byte, or the visitor meets Google's own
# redirect_uri_mismatch screen, which no application code can catch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://online-trash.com/api/auth/google/callback
