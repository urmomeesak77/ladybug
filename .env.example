# Root .env for docker-compose (dev only). Copy to `.env` to override defaults.
# Docker Compose auto-loads `.env` from this directory for ${VAR} substitution.
# The backend app's OWN config stays in backend/.env -- this file is compose-only.

# Single host directory (OUTSIDE the repo) holding all durable dev data:
#   <root>/ladybug-mysql    -> MySQL datadir      (bind-mounted into the db)
#   <root>/ladybug-storage  -> media/storage tree (bind-mounted into the backend)
#   <root>/ladybug-backups  -> .sql dumps         (written by scripts/backup-db.ps1)
# Relocate everything at once by changing this one value. docker-compose.yml
# defaults to C:/docker_permanent when unset, so the stack runs without a .env.
# Use forward slashes for the compose bind source (e.g. D:/ladybug-data).
LADYBUG_DATA_ROOT=C:/docker_permanent

# --- Dev MySQL service config (docker-compose.yml `mysql` service only) ---
# Defaults below reproduce the original hardcoded values, so the stack runs
# with zero config. These configure the MySQL SERVER container. The backend
# APP reads its own DB connection from backend/.env, which is a SEPARATE file:
# if you override MYSQL_DATABASE or MYSQL_ROOT_PASSWORD here you MUST mirror
# them into backend/.env (DB_DATABASE / DB_PASSWORD) by hand -- they cannot be
# auto-linked (injecting DB_* into the backend container overrides phpunit.xml
# and lets tests wipe the dev DB).
MYSQL_DATABASE=trashdb
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=4444
