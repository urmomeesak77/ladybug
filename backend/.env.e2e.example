APP_NAME=Laravel
# `e2e` (not `local`) so routes/api.php registers the test-only /api/testing/reset route the
# Playwright harness calls before each spec. No app behaviour keys on `local`, so this only
# unlocks that reset route; the route is absent in dev/production, which never run as `e2e`.
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Isolated, DISPOSABLE e2e database (docker-compose.e2e.yml -> mysql-e2e, tmpfs).
# This is NEVER the dev trashdb. scripts/e2e.ps1 mounts this file over /app/.env so
# the `php artisan serve` request workers read it directly (serve strips non-whitelisted
# env vars like DB_*, so container env alone does not reach runtime).
DB_CONNECTION=mysql
DB_HOST=mysql-e2e
DB_PORT=3306
DB_DATABASE=ladybug_e2e
DB_USERNAME=root
DB_PASSWORD=root

# File-backed so the SPA cookie-session flow works without extra session/cache tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The isolated e2e frontend origin (docker-compose.e2e.yml -> frontend-e2e on 5174),
# authorized for credentialed CORS and stateful Sanctum cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
FRONTEND_URL=http://localhost:5174

# The e2e specs register several real users and post uploads in a single run from one
# IP; the production-strength abuse throttles (5/min auth, 10/min uploads) would 429
# them. Throttling itself is covered by PHPUnit, not e2e.
AUTH_THROTTLE_PER_MINUTE=1000
UPLOAD_THROTTLE_PER_MINUTE=1000
COMMENT_THROTTLE=1000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
