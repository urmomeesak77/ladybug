APP_NAME=Online-Trash
APP_ENV=local
APP_KEY=
# PRODUCTION MUST set APP_ENV=production and APP_DEBUG=false -- debug mode leaks
# stack traces, env values and queries to visitors -- plus a real APP_URL and
# LOG_LEVEL=warning (or higher). Dev values below.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Comment creation cap, requests per minute per authenticated user (config/app.php
# comment_throttle → the `comments` rate limiter). Raised by the e2e stack, whose
# specs post several comments per run. Defaults to 10.
COMMENT_THROTTLE=10

# Password recovery link (022), both read by Laravel's password broker
# (config/auth.php passwords.users). EXPIRE is how many MINUTES a recovery link
# stays usable (FR-007); THROTTLE is how many SECONDS must pass before the same
# address can be sent a second link (FR-009). Shortening either weakens nothing —
# lengthening EXPIRE widens the window a leaked link is usable in.
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB connection for the Laravel APP. This is a SEPARATE file from the root
# docker-compose .env: DB_DATABASE and DB_PASSWORD must match the compose
# MYSQL_DATABASE / MYSQL_ROOT_PASSWORD (defaults trashdb / root). They can't be
# auto-linked -- injecting DB_* as the backend container's env overrides
# phpunit.xml's SQLite config and lets tests wipe the dev DB, so the sync is
# manual: change one, change the other.
#
# PRODUCTION MUST set DB_USERNAME / DB_PASSWORD to a dedicated NON-ROOT MySQL
# user whose privileges are limited to this one database -- never the root
# account. Dev connects as root only because the local containerised MySQL
# (docker-compose.yml) ships with just the root account.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=trashdb
DB_USERNAME=root
DB_PASSWORD=root

# Seconds PDO waits to CONNECT to MySQL before giving up (PDO::ATTR_TIMEOUT). This is what
# bounds a request's delay when the store is down or unreachable: the access-log write
# below fails inside this budget, is reported into laravel.log, and the response goes out
# normally. It bounds the CONNECT only -- a store that accepts the connection and then
# stalls mid-statement is not covered, because PDO's MySQL driver exposes no read timeout.
# Applies to every query the app makes, not just the access log. Default 2.
DB_CONNECT_TIMEOUT=2

# HTTP access log (023). One row in `access_logs` per request the APPLICATION handled,
# written synchronously before the response is delivered. Read at startup, so any change
# here needs `docker compose restart backend`.
#
# SCOPE, and the first thing to know before reading the history: the access log records
# requests handled by the APPLICATION only. Requests answered directly by nginx -- the
# SPA's static assets and everything under /storage/ -- never reach PHP and therefore
# never appear here. The history answers "who called the API for this meme"; it does not
# answer "who fetched this image file". Ingesting nginx's own access log is a separate
# mechanism with different fields and is not part of this feature.
#
# ENABLED: absent from this file entirely means ON, so a fresh deployment records without
# anyone remembering to enable it. Off writes nothing and erases nothing -- rows already
# stored stay, and responses are byte-for-byte what they would be with the feature
# absent. Default true.
ACCESS_LOG_ENABLED=true
# EXCLUDED_PATHS: comma-separated, matched with $request->is(), so Laravel's `*` wildcards
# work (admin/*) and patterns carry NO leading slash. The two defaults are the liveness
# probes this deployment polls continuously, which would otherwise outnumber real traffic
# in the history. Authentication endpoints are deliberately NOT excluded: they are
# recorded *and* redacted. Default api/health,up.
ACCESS_LOG_EXCLUDED_PATHS=api/health,up
# RETENTION_DAYS: `php artisan access-log:prune` deletes rows strictly older than this
# many days, on the schedule below. Values under 1 are clamped to 1 -- a 0 would delete
# the whole history the window was meant to bound. Default 30.
ACCESS_LOG_RETENTION_DAYS=30
# VALUE_LIMIT: bytes, applied PER VALUE -- each query parameter, each form field, each
# cookie and the raw body are capped independently, and an entry itself has no ceiling.
# Worst-case entry size is therefore value count x limit, NOT the limit: size storage
# against observed traffic. Raising it needs no migration (`body` is longtext and the
# parameter columns are JSON). Default 65536.
ACCESS_LOG_VALUE_LIMIT=65536
# PRUNE_ENABLED / PRUNE_CRON: the application drives its own daily prune so a deployment
# stays bounded without host-level scheduling. 03:00 keeps the delete off the backup
# window on a 1 vCPU box. Defaults true and "0 3 * * *".
ACCESS_LOG_PRUNE_ENABLED=true
ACCESS_LOG_PRUNE_CRON="0 3 * * *"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# "Remember me" (018): session lifetime (minutes) and cookie name used while the
# remember flag cookie is present. Defaults below match config/remember.php.
# REMEMBER_ME_LIFETIME=10080
# REMEMBER_ME_COOKIE=online-trash-remember
# PRODUCTION MUST serve over HTTPS and set SESSION_SECURE_COOKIE=true so the
# session cookie is never sent over plain HTTP.
# SESSION_SECURE_COOKIE=true

# Sanctum SPA auth: the frontend origin(s) that receive stateful session cookies,
# and the credentialed-CORS allowed origin. Comma-separate multiple values.
# FRONTEND_URL is also the base of the email-verification link: the mail must
# land on the SPA's /verify-email/{hash} page, not on the API origin (008).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1:5173,127.0.0.1
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# "Sign in with Google" OAuth client (017). The id and secret are SECRETS: fill them
# in your own .env from the Google Cloud console and never commit a filled-in copy --
# this repository is public. The redirect URI must byte-match one of the client's
# authorised redirect URIs; Google permits http://localhost on any port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

VITE_APP_NAME="${APP_NAME}"

# Absolute path to the Trashpost prototype image library that `php artisan media:seed`
# copies into storage/app/public/image/trash. Configurable (overridable with --source),
# not a secret. Defaults to the documented prototype path below.
MEDIA_SEED_SOURCE='C:\projects\trash\storage\app\public\image\trash'
