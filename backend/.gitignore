# Unanchored: a stray nested backend/backend/coverage.clover slipped past the
# leading-slash forms once already, when the coverage command was run from a
# working directory that resolved one level deeper.
coverage
coverage.clover
coverage.xml
/database/*.sqlite
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
# The SPA shell Laravel composes its <head> into. It is the frontend's BUILD
# output (dist/index.html, with content-hashed asset tags), copied in by the php
# image's node stage -- committing a copy would drift from the real hashes on the
# next vite build and break silently. Dev bind-mounts frontend/index.html here.
/resources/spa
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
